<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context=".presentation.profile.ProfileFragment">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="@dimen/space_beforeOrAfterElement" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_end="@dimen/space_beforeOrAfterElement" />

        <TextView
            android:id="@+id/text_profile_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:layout_marginBottom="@dimen/space_32"
            android:text="@string/profile_text_title"
            android:textAlignment="center"
            android:textSize="32sp"
            app:layout_constraintBottom_toTopOf="@+id/text_user_name_title"
            app:layout_constraintEnd_toEndOf="@+id/guideline_right"
            app:layout_constraintStart_toStartOf="@+id/guideline_left"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/text_user_name_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_beforeOrAfterElement"
            android:text="@string/profile_title_user_name"
            android:textSize="20sp"
            app:layout_constraintBottom_toTopOf="@+id/text_user_name_answer"
            app:layout_constraintEnd_toEndOf="@+id/guideline_right"
            app:layout_constraintStart_toStartOf="@+id/guideline_left"
            app:layout_constraintTop_toBottomOf="@+id/text_profile_title" />

        <TextView
            android:id="@+id/text_user_name_answer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_32"
            android:layout_marginBottom="@dimen/space_32"
            android:textSize="16sp"
            app:layout_constraintBottom_toTopOf="@+id/text_gender_title"
            app:layout_constraintEnd_toEndOf="@+id/guideline_right"
            app:layout_constraintStart_toStartOf="@+id/guideline_left"
            app:layout_constraintTop_toBottomOf="@+id/text_user_name_title" />

        <TextView
            android:id="@+id/text_gender_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_beforeOrAfterElement"
            android:text="@string/profile_title_gender"
            android:textSize="20sp"
            app:layout_constraintBottom_toTopOf="@+id/text_gender_answer"
            app:layout_constraintEnd_toEndOf="@+id/guideline_right"
            app:layout_constraintStart_toStartOf="@+id/guideline_left"
            app:layout_constraintTop_toBottomOf="@+id/text_user_name_answer" />

        <TextView
            android:id="@+id/text_gender_answer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_32"
            android:layout_marginBottom="@dimen/space_32"
            android:textSize="16sp"
            app:layout_constraintBottom_toTopOf="@+id/text_gender_title_is_it_a_boy"
            app:layout_constraintEnd_toEndOf="@+id/guideline_right"
            app:layout_constraintStart_toStartOf="@+id/guideline_left"
            app:layout_constraintTop_toBottomOf="@+id/text_gender_title" />

        <TextView
            android:id="@+id/text_gender_title_is_it_a_boy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_beforeOrAfterElement"
            android:text="@string/profile_title_gender_question"
            android:textSize="20sp"
            app:layout_constraintBottom_toTopOf="@+id/text_gender_answer_is_it_a_boy"
            app:layout_constraintEnd_toEndOf="@+id/guideline_right"
            app:layout_constraintStart_toStartOf="@+id/guideline_left"
            app:layout_constraintTop_toBottomOf="@+id/text_gender_answer" />

        <TextView
            android:id="@+id/text_gender_answer_is_it_a_boy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_32"
            android:layout_marginBottom="@dimen/space_32"
            android:textSize="16sp"
            app:layout_constraintBottom_toTopOf="@+id/text_child_name_title"
            app:layout_constraintEnd_toEndOf="@+id/guideline_right"
            app:layout_constraintStart_toStartOf="@+id/guideline_left"
            app:layout_constraintTop_toBottomOf="@+id/text_gender_title_is_it_a_boy" />

        <TextView
            android:id="@+id/text_child_name_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_beforeOrAfterElement"
            android:text="@string/profile_title_name"
            android:textSize="20sp"
            app:layout_constraintBottom_toTopOf="@+id/text_child_name_answer"
            app:layout_constraintEnd_toEndOf="@+id/guideline_right"
            app:layout_constraintStart_toStartOf="@+id/guideline_left"
            app:layout_constraintTop_toBottomOf="@+id/text_gender_answer_is_it_a_boy" />

        <TextView
            android:id="@+id/text_child_name_answer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_32"
            android:layout_marginBottom="@dimen/space_32"
            android:textSize="16sp"
            app:layout_constraintBottom_toTopOf="@+id/text_hobby_title"
            app:layout_constraintEnd_toEndOf="@+id/guideline_right"
            app:layout_constraintStart_toStartOf="@+id/guideline_left"
            app:layout_constraintTop_toBottomOf="@+id/text_child_name_title" />

        <TextView
            android:id="@+id/text_hobby_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_beforeOrAfterElement"
            android:text="@string/profile_title_hobby"
            android:textSize="20sp"
            app:layout_constraintBottom_toTopOf="@+id/text_hobby_answer"
            app:layout_constraintEnd_toEndOf="@+id/guideline_right"
            app:layout_constraintStart_toStartOf="@+id/guideline_left"
            app:layout_constraintTop_toBottomOf="@+id/text_child_name_answer" />

        <TextView
            android:id="@+id/text_hobby_answer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_32"
            android:layout_marginBottom="@dimen/space_32"
            android:textSize="16sp"
            app:layout_constraintBottom_toTopOf="@+id/text_child_age_title"
            app:layout_constraintEnd_toEndOf="@+id/guideline_right"
            app:layout_constraintStart_toStartOf="@+id/guideline_left"
            app:layout_constraintTop_toBottomOf="@+id/text_hobby_title" />

        <TextView
            android:id="@+id/text_child_age_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_beforeOrAfterElement"
            android:text="@string/profile_title_child_age"
            android:textSize="20sp"
            app:layout_constraintBottom_toTopOf="@+id/text_child_age_answer"
            app:layout_constraintEnd_toEndOf="@+id/guideline_right"
            app:layout_constraintStart_toStartOf="@+id/guideline_left"
            app:layout_constraintTop_toBottomOf="@+id/text_hobby_answer" />

        <TextView
            android:id="@+id/text_child_age_answer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_32"
            android:layout_marginBottom="@dimen/space_32"
            android:text="0"
            android:textSize="16sp"
            app:layout_constraintBottom_toTopOf="@+id/text_birth_date_title"
            app:layout_constraintEnd_toEndOf="@+id/guideline_right"
            app:layout_constraintStart_toStartOf="@+id/guideline_left"
            app:layout_constraintTop_toBottomOf="@+id/text_child_age_title" />

        <TextView
            android:id="@+id/text_birth_date_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_beforeOrAfterElement"
            android:text="@string/profile_title_birth_date"
            android:textSize="20sp"
            app:layout_constraintBottom_toTopOf="@+id/text_birth_date_answer"
            app:layout_constraintEnd_toEndOf="@+id/guideline_right"
            app:layout_constraintStart_toStartOf="@+id/guideline_left"
            app:layout_constraintTop_toBottomOf="@+id/text_child_age_answer" />

        <TextView
            android:id="@+id/text_birth_date_answer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_32"
            android:layout_marginBottom="@dimen/space_32"
            android:textSize="16sp"
            app:layout_constraintBottom_toTopOf="@+id/text_auth_email_title"
            app:layout_constraintEnd_toEndOf="@+id/guideline_right"
            app:layout_constraintStart_toStartOf="@+id/guideline_left"
            app:layout_constraintTop_toBottomOf="@+id/text_birth_date_title" />

        <!-- TextView
            android:id="@+id/text_display_email_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_beforeOrAfterElement"
            android:text="@string/profile_title_display_email"
            android:textSize="20sp"
            app:layout_constraintBottom_toTopOf="@+id/linear_display_email_answer"
            app:layout_constraintEnd_toEndOf="@+id/guideline_right"
            app:layout_constraintStart_toStartOf="@+id/guideline_left"
            app:layout_constraintTop_toBottomOf="@+id/text_birth_date_answer" / -->

        <!-- LinearLayout
            android:id="@+id/linear_display_email_answer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_beforeOrAfterElement"
            android:layout_marginEnd="@dimen/space_beforeOrAfterElement"
            android:layout_marginBottom="@dimen/space_32"
            android:gravity="center_vertical"
