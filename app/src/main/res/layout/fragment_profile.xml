        <TextView
            android:id="@+id/text_auth_email_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_beforeOrAfterElement"
            android:text="@string/profile_title_auth_email"
            android:textSize="20sp"
            app:layout_constraintBottom_toTopOf="@+id/linear_auth_email_answer"
            app:layout_constraintEnd_toEndOf="@+id/guideline_right"
            app:layout_constraintStart_toStartOf="@+id/guideline_left"
            app:layout_constraintTop_toBottomOf="@+id/text_birth_date_answer" />

        <LinearLayout
            android:id="@+id/linear_auth_email_answer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_beforeOrAfterElement"
            android:layout_marginEnd="@dimen/space_beforeOrAfterElement"
            android:layout_marginBottom="@dimen/space_beforeOrAfterElement"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:textSize="16sp"
            android:weightSum="2"
            app:layout_constraintBottom_toTopOf="@+id/linear_email_verification"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_auth_email_title">

            <TextView
                android:id="@+id/text_auth_email_answer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAlignment="center"
                android:textColor="@color/purple_200" />

            <Button
                android:id="@+id/button_change_auth_email"
                style="@style/Widget.AppCompat.ActionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/button_rounded_corners"
                android:paddingStart="@dimen/space_32"
                android:paddingEnd="@dimen/space_32"
                android:text="@string/profile_change_email"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="@dimen/button_text"
                android:textStyle="bold"
                app:backgroundTint="@null" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linear_email_verification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_beforeOrAfterElement"
            android:layout_marginEnd="@dimen/space_beforeOrAfterElement"
            android:layout_marginBottom="@dimen/space_32"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="visible"
            android:weightSum="2"
            app:layout_constraintBottom_toTopOf="@+id/button_save_fields_to_server"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/linear_auth_email_answer">

            <TextView
                android:id="@+id/text_email_not_verified"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/profile_email_not_verified"
                android:textAlignment="center"
                android:textColor="@color/purple_200" />

            <Button
                android:id="@+id/button_verify_email"
                style="@style/Widget.AppCompat.ActionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/button_rounded_corners"
                android:paddingStart="@dimen/space_32"
                android:paddingEnd="@dimen/space_32"
                android:text="@string/profile_verify_email"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="@dimen/button_text"
                android:textStyle="bold"
                app:backgroundTint="@null" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_save_fields_to_server"
            style="@style/Widget.AppCompat.ActionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_32"
            android:background="@drawable/button_rounded_corners"
            android:paddingStart="@dimen/space_32"
            android:paddingEnd="@dimen/space_32"
            android:text="@string/profile_button_save_fields_to_server"
            android:textColor="@color/white"
            android:textSize="@dimen/button_text"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="@null"
            app:layout_constraintBottom_toTopOf="@+id/button_download_fields_from_server"
            app:layout_constraintLeft_toLeftOf="@+id/guideline_left"
            app:layout_constraintRight_toRightOf="@+id/guideline_right"
            app:layout_constraintTop_toBottomOf="@+id/linear_email_verification" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_download_fields_from_server"
            style="@style/Widget.AppCompat.ActionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_32"
            android:background="@drawable/button_rounded_corners"
            android:paddingStart="@dimen/space_32"
            android:paddingEnd="@dimen/space_32"
            android:text="@string/profile_button_download_fields_from_server"
            android:textColor="@color/white"
            android:textSize="@dimen/button_text"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="@null"
            app:layout_constraintBottom_toTopOf="@+id/language_material_card_view"
            app:layout_constraintLeft_toLeftOf="@+id/guideline_left"
            app:layout_constraintRight_toRightOf="@+id/guideline_right"
            app:layout_constraintTop_toBottomOf="@+id/button_save_fields_to_server" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/language_material_card_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="0dp"
            android:layout_marginVertical="8dp"
            app:layout_constraintBottom_toTopOf="@+id/button_refill_fields"
            app:layout_constraintLeft_toLeftOf="@+id/guideline_left"
            app:layout_constraintRight_toRightOf="@+id/guideline_right"
            app:layout_constraintTop_toBottomOf="@+id/button_download_fields_from_server">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/rgName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_language_settings"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgLanguage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/rbSystem"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_lang_system" />

                    <RadioButton
                        android:id="@+id/rbRussian"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_lang_ru"
                        android:layout_marginStart="16dp" />

                    <RadioButton
                        android:id="@+id/rbEnglish"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_lang_en"
                        android:layout_marginStart="16dp" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_refill_fields"
            style="@style/Widget.AppCompat.ActionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_32"
            android:background="@drawable/button_rounded_corners"
            android:paddingStart="@dimen/space_32"
            android:paddingEnd="@dimen/space_32"
            android:text="@string/profile_button_refill_fields"
            android:textColor="@color/white"
            android:textSize="@dimen/button_text"
            android:textStyle="bold"
            android:visibility="visible"
            app:backgroundTint="@null"
            app:layout_constraintBottom_toTopOf="@+id/button_register_and_login"
            app:layout_constraintLeft_toLeftOf="@+id/guideline_left"
            app:layout_constraintRight_toRightOf="@+id/guideline_right"
            app:layout_constraintTop_toBottomOf="@+id/language_material_card_view" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_register_and_login"
            style="@style/Widget.AppCompat.ActionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_beforeOrAfterElement"
            android:background="@drawable/button_rounded_corners"
            android:paddingStart="@dimen/space_32"
            android:paddingEnd="@dimen/space_32"
            android:text="@string/profile_button_register"
            android:textColor="@color/white"
            android:textSize="@dimen/button_text"
            android:textStyle="bold"
            android:visibility="visible"
            app:backgroundTint="@null"
            app:layout_constraintBottom_toTopOf="@+id/text_warning"
            app:layout_constraintLeft_toLeftOf="@+id/guideline_left"
            app:layout_constraintRight_toRightOf="@+id/guideline_right"
            app:layout_constraintTop_toBottomOf="@+id/button_refill_fields" />

        <TextView
            android:id="@+id/text_warning"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_32"
            android:text="@string/profile_text_warning"
            android:textSize="16sp"
            app:layout_constraintBottom_toTopOf="@+id/button_log_in"
            app:layout_constraintEnd_toEndOf="@+id/guideline_right"
            app:layout_constraintStart_toStartOf="@+id/guideline_left"
            app:layout_constraintTop_toBottomOf="@+id/button_register_and_login" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_log_in"
            style="@style/Widget.AppCompat.ActionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_beforeOrAfterElement"
            android:background="@drawable/button_rounded_corners"
            android:paddingStart="@dimen/space_32"
            android:paddingEnd="@dimen/space_32"
            android:text="@string/profile_button_log_in"
            android:textColor="@color/white"
            android:textSize="@dimen/button_text"
            android:textStyle="bold"
            android:visibility="visible"
            app:backgroundTint="@null"
            app:layout_constraintBottom_toTopOf="@+id/text_warning_data"
            app:layout_constraintLeft_toLeftOf="@+id/guideline_left"
            app:layout_constraintRight_toRightOf="@+id/guideline_right"
            app:layout_constraintTop_toBottomOf="@+id/text_warning" />

        <TextView
            android:id="@+id/text_warning_data"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_32"
            android:text="@string/profile_text_warning_data"
            android:textSize="16sp"
            app:layout_constraintBottom_toTopOf="@+id/button_log_out"
            app:layout_constraintEnd_toEndOf="@+id/guideline_right"
            app:layout_constraintStart_toStartOf="@+id/guideline_left"
            app:layout_constraintTop_toBottomOf="@+id/button_log_in" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_log_out"
            style="@style/Widget.AppCompat.ActionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_32"
            android:background="@drawable/button_rounded_corners"
            android:paddingStart="@dimen/space_32"
            android:paddingEnd="@dimen/space_32"
            android:text="@string/profile_button_log_out"
            android:textColor="@color/white"
            android:textSize="@dimen/button_text"
            android:textStyle="bold"
            android:visibility="visible"
            app:backgroundTint="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="@+id/guideline_left"
            app:layout_constraintRight_toRightOf="@+id/guideline_right"
            app:layout_constraintTop_toBottomOf="@+id/text_warning_data" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>