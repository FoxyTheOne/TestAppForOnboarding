    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/text_field_birth_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_32"
        android:hint="@string/text_birth_date_hint"
        app:endIconContentDescription="@string/text_select_date_hint"
        app:helperText="@string/text_select_date_helper"
        app:helperTextEnabled="true"
        app:endIconDrawable="@drawable/baseline_calendar_month_24"
        app:endIconMode="custom"
        app:layout_constraintBottom_toTopOf="@+id/text_child_age_label"
        app:layout_constraintEnd_toEndOf="@+id/guideline_right"
        app:layout_constraintStart_toStartOf="@+id/guideline_left"
        app:layout_constraintTop_toBottomOf="@+id/text_question_birth_date">

        <!-- com.foxynest.testappforonboarding.other.utils.BaseTextInputEditText
            android:id="@+id/edit_text_birth_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionNext"
            android:inputType="date"
            android:maxLines="1" / -->

        <com.foxynest.testappforonboarding.other.utils.BaseTextInputEditText
            android:id="@+id/edit_text_birth_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="false"
            android:cursorVisible="false"
            android:imeOptions="actionNext"
            android:inputType="none"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/text_child_age_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_beforeOrAfterElement"
        android:text="@string/text_child_age"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/text_child_age_value"
        app:layout_constraintEnd_toEndOf="@+id/guideline_right"
        app:layout_constraintStart_toStartOf="@+id/guideline_left"
        app:layout_constraintTop_toBottomOf="@+id/text_field_birth_date" />

    <!-- Отображение возраста -->
    <TextView
        android:id="@+id/text_child_age_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_32"
        android:text="0"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/buttons_linear_layout"
        app:layout_constraintEnd_toEndOf="@+id/guideline_right"
        app:layout_constraintStart_toStartOf="@+id/guideline_left"
        app:layout_constraintTop_toBottomOf="@+id/text_child_age_label" />

