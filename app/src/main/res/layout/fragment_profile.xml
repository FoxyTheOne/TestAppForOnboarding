<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context=".presentation.profile.ProfileFragment">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="@dimen/space_beforeOrAfterElement" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_end="@dimen/space_beforeOrAfterElement" />

        <TextView
            android:id="@+id/text_profile_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:text="@string/profile_text_title"
            android:textAlignment="center"
            android:textSize="32sp"
            app:layout_constraintBottom_toTopOf="@+id/text_gender_title"
            app:layout_constraintEnd_toEndOf="@+id/guideline_right"
            app:layout_constraintHorizontal_bias="0.25"
            app:layout_constraintStart_toStartOf="@+id/guideline_left"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/text_gender_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:text="@string/profile_title_gender"
            android:textSize="20sp"
            app:layout_constraintBottom_toTopOf="@+id/text_gender_answer"
            app:layout_constraintEnd_toEndOf="@+id/guideline_right"
            app:layout_constraintHorizontal_bias="0.25"
            app:layout_constraintStart_toStartOf="@+id/guideline_left"
            app:layout_constraintTop_toBottomOf="@+id/text_profile_title"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/text_gender_answer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_32"
            android:layout_marginTop="@dimen/space_beforeOrAfterElement"
            android:textSize="16sp"
            app:layout_constraintBottom_toTopOf="@+id/text_gender_title_is_it_a_boy"
            app:layout_constraintEnd_toEndOf="@+id/guideline_right"
            app:layout_constraintHorizontal_bias="0.25"
            app:layout_constraintStart_toStartOf="@+id/guideline_left"
            app:layout_constraintTop_toBottomOf="@+id/text_gender_title"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/text_gender_title_is_it_a_boy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:text="@string/profile_title_gender_question"
            android:textSize="20sp"
            app:layout_constraintBottom_toTopOf="@+id/text_gender_answer_is_it_a_boy"
            app:layout_constraintEnd_toEndOf="@+id/guideline_right"
            app:layout_constraintHorizontal_bias="0.25"
            app:layout_constraintStart_toStartOf="@+id/guideline_left"
            app:layout_constraintTop_toBottomOf="@+id/text_gender_answer"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/text_gender_answer_is_it_a_boy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_32"
            android:layout_marginTop="@dimen/space_beforeOrAfterElement"
            android:textSize="16sp"
            app:layout_constraintBottom_toTopOf="@+id/text_name_title"
            app:layout_constraintEnd_toEndOf="@+id/guideline_right"
            app:layout_constraintHorizontal_bias="0.25"
            app:layout_constraintStart_toStartOf="@+id/guideline_left"
            app:layout_constraintTop_toBottomOf="@+id/text_gender_title_is_it_a_boy"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/text_name_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:text="@string/profile_title_name"
            android:textSize="20sp"
            app:layout_constraintBottom_toTopOf="@+id/text_name_answer"
            app:layout_constraintEnd_toEndOf="@+id/guideline_right"
            app:layout_constraintHorizontal_bias="0.25"
            app:layout_constraintStart_toStartOf="@+id/guideline_left"
            app:layout_constraintTop_toBottomOf="@+id/text_gender_answer_is_it_a_boy"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/text_name_answer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_32"
            android:layout_marginTop="@dimen/space_beforeOrAfterElement"
            android:textSize="16sp"
            app:layout_constraintBottom_toTopOf="@+id/text_hobby_title"
            app:layout_constraintEnd_toEndOf="@+id/guideline_right"
            app:layout_constraintHorizontal_bias="0.25"
            app:layout_constraintStart_toStartOf="@+id/guideline_left"
            app:layout_constraintTop_toBottomOf="@+id/text_name_title"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/text_hobby_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:text="@string/profile_title_hobby"
            android:textSize="20sp"
            app:layout_constraintBottom_toTopOf="@+id/text_hobby_answer"
            app:layout_constraintEnd_toEndOf="@+id/guideline_right"
            app:layout_constraintHorizontal_bias="0.25"
            app:layout_constraintStart_toStartOf="@+id/guideline_left"
            app:layout_constraintTop_toBottomOf="@+id/text_name_answer"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/text_hobby_answer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_32"
            android:layout_marginTop="@dimen/space_beforeOrAfterElement"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="@+id/guideline_right"
            app:layout_constraintHorizontal_bias="0.25"
            app:layout_constraintBottom_toTopOf="@+id/text_warning"
            app:layout_constraintStart_toStartOf="@+id/guideline_left"
            app:layout_constraintTop_toBottomOf="@+id/text_hobby_title"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/text_warning"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:layout_marginBottom="@dimen/space_beforeOrAfterElement"
            android:text="@string/profile_text_warning"
            android:textSize="16sp"
            app:layout_constraintBottom_toTopOf="@+id/button_register_and_login"
            app:layout_constraintEnd_toEndOf="@+id/guideline_right"
            app:layout_constraintHorizontal_bias="0.25"
            app:layout_constraintStart_toStartOf="@+id/guideline_left"
            app:layout_constraintTop_toBottomOf="@+id/text_hobby_answer"
            app:layout_constraintVertical_chainStyle="packed" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_register_and_login"
            style="@style/Widget.AppCompat.ActionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_32"
            android:background="@drawable/button_rounded_corners"
            android:paddingStart="@dimen/space_32"
            android:paddingEnd="@dimen/space_32"
            android:text="@string/profile_button_register"
            android:textColor="@color/white"
            android:textSize="@dimen/button_text"
            android:textStyle="bold"
            android:visibility="visible"
            app:backgroundTint="@null"
            app:layout_constraintBottom_toTopOf="@+id/button_log_in"
            app:layout_constraintLeft_toLeftOf="@+id/guideline_left"
            app:layout_constraintRight_toRightOf="@+id/guideline_right"
            app:layout_constraintTop_toBottomOf="@+id/text_warning"
            app:layout_constraintVertical_chainStyle="packed" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_log_in"
            style="@style/Widget.AppCompat.ActionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_beforeOrAfterElement"
            android:background="@drawable/button_rounded_corners"
            android:paddingStart="@dimen/space_32"
            android:paddingEnd="@dimen/space_32"
            android:text="@string/profile_button_log_in"
            android:textColor="@color/white"
            android:textSize="@dimen/button_text"
            android:textStyle="bold"
            android:visibility="visible"
            app:backgroundTint="@null"
            app:layout_constraintBottom_toTopOf="@+id/text_warning_data"
            app:layout_constraintLeft_toLeftOf="@+id/guideline_left"
            app:layout_constraintRight_toRightOf="@+id/guideline_right"
            app:layout_constraintTop_toBottomOf="@+id/button_register_and_login"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/text_warning_data"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_32"
            android:text="@string/profile_text_warning_data"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/guideline_right"
            app:layout_constraintHorizontal_bias="0.25"
            app:layout_constraintStart_toStartOf="@+id/guideline_left"
            app:layout_constraintTop_toBottomOf="@+id/button_log_in"
            app:layout_constraintVertical_chainStyle="packed" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>