    <LinearLayout
        android:id="@+id/buttons_yes_linear_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_32"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/guideline_left"
        app:layout_constraintRight_toRightOf="@+id/guideline_right"
        app:layout_constraintTop_toBottomOf="@+id/text_question_is_it_a_boy"
        app:layout_constraintVertical_chainStyle="packed">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/button_back"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_small"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/space_32"
            android:paddingEnd="@dimen/space_32"
            app:backgroundTint="@null"
            app:srcCompat="@drawable/baseline_arrow_back_24" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_yes"
            style="@style/Widget.AppCompat.ActionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_small"
            android:layout_weight="2"
            android:background="@drawable/button_rounded_corners"
            android:paddingStart="@dimen/space_32"
            android:paddingEnd="@dimen/space_32"
            android:text="@string/yes"
            android:textColor="@color/white"
            android:textSize="@dimen/button_text"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_no"
            style="@style/Widget.AppCompat.ActionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/button_rounded_corners"
            android:paddingStart="@dimen/space_32"
            android:paddingEnd="@dimen/space_32"
            android:text="@string/no"
            android:textColor="@color/white"
            android:textSize="@dimen/button_text"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="@null" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>